
//@version=6
indicator(title = "Range - Raid - Run [BYSSB]", shorttitle = "Range - Raid - Run [BYSSB]", overlay = true, max_lines_count = 500, max_boxes_count = 500, max_labels_count = 500, max_bars_back = 500)

const string GRP_CRT  = "CANDLE RANGE HIGH AND LOW"
const string GRP_OPT  = "OPTIONS"
const string GRP_FVG  = "FAIR VALUE GAP (CRT SWEEP REVEAL)"
const string GRP_CISD = "CISD SIGNALS"
const string GRP_VIS  = "VISUAL COLORS"

const string TT_RESET     = "Maximum number of CRT-timeframe candles allowed to close inside the active Candle Range before the range is automatically reset to the nearest (most recent) closed candle. A candle that closes outside the range resets it immediately."
const string TT_EXT_LOWER = "Number of bars the CRH, CRL and 50% lines are extended to the right of the current bar when the chart timeframe is LOWER than the CRT timeframe. This area also hosts the projected Range / Raid / Run candles and the countdown labels."
const string TT_EXT_SAME  = "Number of bars the CRH, CRL and 50% lines are extended to the right of the current bar when the chart timeframe is the SAME as or HIGHER than the CRT timeframe (the chart candles themselves are then used as CRT candles)."
const string TT_CISD_LB   = "Maximum number of chart bars after a valid CRT sweep within which the CISD confirmation (a close beyond the open of the delivery candle series) must happen. Also used as the maximum age of the delivery candle series."
const string TT_ALERTS    = "Enables alert() calls for BUY, SELL, CRT Sweep High and CRT Sweep Low. Create an alert with the condition 'Any alert() function call' to receive them. Individual alertcondition() entries are always available as well."

int    maxSetupsInput    = input.int(5, "Max Setups To Show", minval = 1, maxval = 50, tooltip = "Maximum number of setups kept on the chart. A setup = CRT sweep label + revealed FVG box + BUY/SELL line and label. When the limit is reached, the oldest setup is removed automatically.", group = GRP_CRT)
bool   showCrtInput      = input.bool(true, "CRT TIMEFRAME", group = GRP_CRT)
string crtTfInput        = input.timeframe("60", "CRT", group = GRP_CRT)
color  crtColorInput     = input.color(color.black, "CRT Color", group = GRP_CRT)
bool   showMidInput      = input.bool(true, "50%", inline = "CRT_MID", group = GRP_CRT)
color  midColorInput     = input.color(color.new(#434651, 35), "CRT Mid Color", inline = "CRT_MID", group = GRP_CRT)
string labelSizeInput    = input.string("small", "CRT Label Size", options = ["tiny", "small", "normal", "large", "huge"], group = GRP_CRT)
int    maxResetInput     = input.int(6, "Max Candles Before Reset (Nearest CRT)", minval = 1, maxval = 50, tooltip = TT_RESET, group = GRP_CRT)

int    lineWidthInput    = input.int(1, "High/Low Line Width", minval = 1, maxval = 10, group = GRP_OPT)
bool   extendRightInput  = input.bool(true, "Extend Lines Right", group = GRP_OPT)
bool   showLabelsInput   = input.bool(true, "Show CRT Labels", group = GRP_OPT)
int    extendLowerInput  = input.int(30, "CRH & CRL Extend (Lower Timeframe)", minval = 0, maxval = 300, tooltip = TT_EXT_LOWER, group = GRP_OPT)
int    extendHigherInput = input.int(3, "CRH & CRL Extend (Same/Higher Timeframe)", minval = 0, maxval = 300, tooltip = TT_EXT_SAME, group = GRP_OPT)
bool   showDashInput     = input.bool(true, "Show Timeframe Dashboard", group = GRP_OPT)

bool   showFvgInput      = input.bool(true, "Show FVG Touched By CRT Sweep", group = GRP_FVG)
color  bullFvgColorInput = input.color(color.new(#787B86, 60), "Bullish FVG Color", group = GRP_FVG)
color  bearFvgColorInput = input.color(color.new(#787B86, 60), "Bearish FVG Color", group = GRP_FVG)
string fvgTfInput        = input.string("CRT Timeframe", "FVG Timeframe", options = ["CRT Timeframe", "Chart", "5m", "15m", "30m", "1H", "2H", "3H", "4H", "6H", "12H", "1D"], tooltip = "Timeframe used to detect the Fair Value Gaps. 'CRT Timeframe' follows the CRT timeframe selected above (e.g. CRT 1 hour = 1H FVGs). If the selected timeframe is lower than the chart, the chart timeframe is used.", group = GRP_FVG)

bool   showCisdInput     = input.bool(true, "Show CISD Buy/Sell Signals", group = GRP_CISD)
color  buyColorInput     = input.color(#22AB94, "Buy Color", inline = "CISD_COL", group = GRP_CISD)
color  sellColorInput    = input.color(#F23645, "Sell Color", inline = "CISD_COL", group = GRP_CISD)
int    cisdLookbackInput = input.int(20, "CISD Lookback / Max Bars", minval = 2, maxval = 300, tooltip = TT_CISD_LB, group = GRP_CISD)
bool   showAlertsInput   = input.bool(true, "Show Alerts", tooltip = TT_ALERTS, group = GRP_CISD)

color  sweepColorInput        = input.color(#F23645, "CRT Sweep Color", group = GRP_VIS)
color  sepColorInput          = input.color(color.new(#787B86, 50), "Time Separator Color", group = GRP_VIS)
color  dashHeaderColorInput   = input.color(#3C3C3C, "Dashboard Header", inline = "DASH_A", group = GRP_VIS)
color  dashTfColorInput       = input.color(#BDBDBD, "Timeframe Cell", inline = "DASH_A", group = GRP_VIS)
color  dashActiveColorInput   = input.color(#45FF45, "Active", inline = "DASH_B", group = GRP_VIS)
color  dashInactiveColorInput = input.color(#FF5252, "Inactive", inline = "DASH_B", group = GRP_VIS)

const int    PROJ_SPACING     = 3
const int    PROJ_HALF_WIDTH  = 1
const int    PROJ_RIGHT_PAD   = 7
const int    MAX_FUTURE_BARS  = 480
const int    FVG_POOL_MAX     = 100
const int    FVG_MAX_AGE      = 3000
const int    MAX_MID_CANDLES  = 60
const color  CLR_NONE         = #00000000
const color  DASH_TEXT_DARK   = #1A1A1A
const color  DASH_TEXT_LIGHT  = #FFFFFF
const color  DASH_BORDER      = #8C8C8C
const string DASH_TITLE       = "CRTBYSSB"

type HtfCandle
    float o        = na
    float h        = na
    float l        = na
    float c        = na
    int   startBar = na
    int   hBar     = na
    int   lBar     = na

type FvgZone
    float top      = na
    float bottom   = na
    int   leftTime = na
    bool  isBull   = true

f_labelSize(string sizeName) =>
    switch sizeName
        "tiny"   => size.tiny
        "small"  => size.small
        "normal" => size.normal
        "large"  => size.large
        "huge"   => size.huge
        => size.small

f_tfLabel(int tfSeconds) =>
    string result = ""
    if na(tfSeconds) or tfSeconds <= 0
        result := "CRT"
    else if tfSeconds < 60
        result := str.tostring(tfSeconds) + "s"
    else if tfSeconds < 3600
        result := str.tostring(math.round(tfSeconds / 60)) + "m"
    else if tfSeconds < 86400
        result := str.tostring(math.round(tfSeconds / 3600)) + "H"
    else if tfSeconds < 604800
        result := str.tostring(math.round(tfSeconds / 86400)) + "D"
    else if tfSeconds < 2419200
        result := str.tostring(math.round(tfSeconds / 604800)) + "W"
    else
        result := str.tostring(math.max(1, math.round(tfSeconds / 2628003))) + "M"
    result

f_countdown(int msLeft) =>
    int totalSec = na(msLeft) ? 0 : math.max(0, math.floor(msLeft / 1000))
    int hh       = math.floor(totalSec / 3600)
    int mm       = math.floor((totalSec % 3600) / 60)
    int ss       = totalSec % 60
    string clock = hh > 0 ? str.tostring(hh) + ":" + str.tostring(mm, "00") + ":" + str.tostring(ss, "00") : str.tostring(mm, "00") + ":" + str.tostring(ss, "00")
    "(" + clock + ")"

f_tfActive(int maxAge) =>
    var float rangeHi  = na
    var float rangeLo  = na
    var int   rangeAge = 0
    float prevHigh  = high[1]
    float prevLow   = low[1]
    float prevClose = close[1]
    if not na(prevHigh) and not na(prevLow)
        bool closedOutside = not na(rangeHi) and (prevClose > rangeHi or prevClose < rangeLo)
        if na(rangeHi) or closedOutside or rangeAge >= maxAge
            rangeHi  := prevHigh
            rangeLo  := prevLow
            rangeAge := 0
        else
            rangeAge += 1
    int state = not na(rangeHi) and close <= rangeHi and close >= rangeLo ? 1 : 0
    state

f_capLabels(array<label> arr, int maxSize) =>
    while arr.size() > maxSize
        label.delete(arr.shift())
    arr.size()

f_capLines(array<line> arr, int maxSize) =>
    while arr.size() > maxSize
        line.delete(arr.shift())
    arr.size()

f_capBoxes(array<box> arr, int maxSize) =>
    while arr.size() > maxSize
        box.delete(arr.shift())
    arr.size()

f_clearLines(array<line> arr) =>
    for ln in arr
        line.delete(ln)
    arr.clear()
    true

f_clearBoxes(array<box> arr) =>
    for bx in arr
        box.delete(bx)
    arr.clear()
    true

string tfSelected  = crtTfInput == "" ? timeframe.period : crtTfInput
int    chartSec    = timeframe.in_seconds(timeframe.period)
int    selectedSec = timeframe.in_seconds(tfSelected)
bool   htfMode     = selectedSec > chartSec
string tfEff       = htfMode ? tfSelected : timeframe.period
int    tfEffSec    = htfMode ? selectedSec : chartSec
string tfText      = f_tfLabel(tfEffSec)
int    extendBars  = htfMode ? extendLowerInput : extendHigherInput
string lblSize     = f_labelSize(labelSizeInput)

bool tfChanged = timeframe.change(tfEff)
int  htfCloseT = time_close(tfEff)
bool isNewHtf  = htfMode ? tfChanged : true

int st1h  = request.security(syminfo.tickerid, "60",  f_tfActive(maxResetInput))
int st2h  = request.security(syminfo.tickerid, "120", f_tfActive(maxResetInput))
int st3h  = request.security(syminfo.tickerid, "180", f_tfActive(maxResetInput))
int st4h  = request.security(syminfo.tickerid, "240", f_tfActive(maxResetInput))
int st6h  = request.security(syminfo.tickerid, "360", f_tfActive(maxResetInput))
int st12h = request.security(syminfo.tickerid, "720", f_tfActive(maxResetInput))

string fvgTfRaw = switch fvgTfInput
    "CRT Timeframe" => tfEff
    "Chart"         => timeframe.period
    "5m"            => "5"
    "15m"           => "15"
    "30m"           => "30"
    "1H"            => "60"
    "2H"            => "120"
    "3H"            => "180"
    "4H"            => "240"
    "6H"            => "360"
    "12H"           => "720"
    "1D"            => "D"
    => tfEff
string fvgTf = timeframe.in_seconds(fvgTfRaw) < chartSec ? timeframe.period : fvgTfRaw

[fvgBullGap, fvgBearGap, fvgBullTop, fvgBullBot, fvgBearTop, fvgBearBot, fvgLeftT, fvgKeyT] = request.security(syminfo.tickerid, fvgTf, [low[1] > high[3], high[1] < low[3], low[1], high[3], low[3], high[1], time[3], time[1]], lookahead = barmerge.lookahead_on)
bool newFvgCandle = not na(fvgKeyT) and fvgKeyT != nz(fvgKeyT[1])

bool isBearBar   = close < open
bool isBullBar   = close > open
bool prevBearBar = close[1] < open[1]
bool prevBullBar = close[1] > open[1]

var float bearSeqOpen = na
var int   bearSeqBar  = na
var float bullSeqOpen = na
var int   bullSeqBar  = na

if isBearBar and not prevBearBar
    bearSeqOpen := open
    bearSeqBar  := bar_index
if isBullBar and not prevBullBar
    bullSeqOpen := open
    bullSeqBar  := bar_index

var HtfCandle        curCandle   = na
var HtfCandle        rangeCandle = na
var array<HtfCandle> midCandles  = array.new<HtfCandle>()
var bool  hasRange      = false
var int   rangeAge      = 0
var bool  sweptHigh     = false
var bool  sweptLow      = false
var float trkLow        = na
var float trkLowLvl     = na
var int   trkLowLvlBar  = na
var float trkHigh       = na
var float trkHighLvl    = na
var int   trkHighLvlBar = na
var bool  armBull       = false
var bool  armBear       = false
var int   armBullBar    = na
var int   armBearBar    = na

var int rangeCount     = 0
var int sweepHighCount = 0
var int sweepLowCount  = 0
var int buyCount       = 0
var int sellCount      = 0

if na(curCandle)
    curCandle := HtfCandle.new(open, high, low, close, bar_index, bar_index, bar_index)
else if isNewHtf
    HtfCandle closedCandle = curCandle
    bool resetRange = false
    if not hasRange
        resetRange := true
    else
        bool closedInside = closedCandle.c <= rangeCandle.h and closedCandle.c >= rangeCandle.l
        resetRange := not closedInside or rangeAge >= maxResetInput
    if resetRange
        rangeCandle   := closedCandle
        hasRange      := true
        rangeAge      := 0
        rangeCount    += 1
        midCandles.clear()
        sweptHigh     := false
        sweptLow      := false
        armBull       := false
        armBear       := false
        trkLow        := na
        trkLowLvl     := na
        trkLowLvlBar  := na
        trkHigh       := na
        trkHighLvl    := na
        trkHighLvlBar := na
    else
        rangeAge += 1
        midCandles.push(closedCandle)
        if midCandles.size() > MAX_MID_CANDLES
            midCandles.shift()
    curCandle := HtfCandle.new(open, high, low, close, bar_index, bar_index, bar_index)
else
    if high > curCandle.h
        curCandle.h    := high
        curCandle.hBar := bar_index
    if low < curCandle.l
        curCandle.l    := low
        curCandle.lBar := bar_index
    curCandle.c := close

float rH = na
float rL = na
float rM = na
if hasRange
    rH := rangeCandle.h
    rL := rangeCandle.l
    rM := (rH + rL) / 2

if hasRange
    if na(trkLow) or low < trkLow
        trkLow := low
        bool bearSeqOk = not na(bearSeqBar) and bar_index - bearSeqBar <= cisdLookbackInput and bearSeqOpen > low
        trkLowLvl    := bearSeqOk ? bearSeqOpen : high
        trkLowLvlBar := bearSeqOk ? bearSeqBar : bar_index
    if na(trkHigh) or high > trkHigh
        trkHigh := high
        bool bullSeqOk = not na(bullSeqBar) and bar_index - bullSeqBar <= cisdLookbackInput and bullSeqOpen < high
        trkHighLvl    := bullSeqOk ? bullSeqOpen : low
        trkHighLvlBar := bullSeqOk ? bullSeqBar : bar_index

bool bullSweepRaw = hasRange and not sweptLow  and close > rL and close < rH and (low < rL or close[1] < rL)
bool bearSweepRaw = hasRange and not sweptHigh and close < rH and close > rL and (high > rH or close[1] > rH)
bool bullSweep    = bullSweepRaw and barstate.isconfirmed
bool bearSweep    = bearSweepRaw and barstate.isconfirmed

var array<label>   sweepLabels = array.new<label>()
var array<box>     fvgBoxes    = array.new<box>()
var array<FvgZone> fvgPool     = array.new<FvgZone>()

if bullSweep
    sweptLow      := true
    armBull       := true
    armBullBar    := bar_index
    sweepLowCount += 1
    if showCrtInput and showLabelsInput
        sweepLabels.push(label.new(bar_index, low, "CRT", xloc = xloc.bar_index, style = label.style_label_up, color = CLR_NONE, textcolor = sweepColorInput, size = lblSize, tooltip = tfText + " CRT Sweep | CRL taken: " + str.tostring(rL, format.mintick)))
        f_capLabels(sweepLabels, maxSetupsInput)
    if fvgPool.size() > 0
        float sweepLowPx = math.min(low, nz(trkLow, low))
        for i = fvgPool.size() - 1 to 0
            FvgZone zone = fvgPool.get(i)
            if zone.isBull and sweepLowPx <= zone.top and high >= zone.bottom
                if showFvgInput
                    fvgBoxes.push(box.new(zone.leftTime, zone.top, time, zone.bottom, border_color = bullFvgColorInput, border_width = 0, xloc = xloc.bar_time, bgcolor = bullFvgColorInput))
                    f_capBoxes(fvgBoxes, maxSetupsInput)
                fvgPool.remove(i)

if bearSweep
    sweptHigh      := true
    armBear        := true
    armBearBar     := bar_index
    sweepHighCount += 1
    if showCrtInput and showLabelsInput
        sweepLabels.push(label.new(bar_index, high, "CRT", xloc = xloc.bar_index, style = label.style_label_down, color = CLR_NONE, textcolor = sweepColorInput, size = lblSize, tooltip = tfText + " CRT Sweep | CRH taken: " + str.tostring(rH, format.mintick)))
        f_capLabels(sweepLabels, maxSetupsInput)
    if fvgPool.size() > 0
        float sweepHighPx = math.max(high, nz(trkHigh, high))
        for i = fvgPool.size() - 1 to 0
            FvgZone zone = fvgPool.get(i)
            if not zone.isBull and sweepHighPx >= zone.bottom and low <= zone.top
                if showFvgInput
                    fvgBoxes.push(box.new(zone.leftTime, zone.top, time, zone.bottom, border_color = bearFvgColorInput, border_width = 0, xloc = xloc.bar_time, bgcolor = bearFvgColorInput))
                    f_capBoxes(fvgBoxes, maxSetupsInput)
                fvgPool.remove(i)

bool cisdBuyRaw  = false
bool cisdSellRaw = false

if armBull and barstate.isconfirmed
    if not na(trkLowLvl) and close > trkLowLvl
        cisdBuyRaw := true
        armBull    := false
        buyCount   += 1
    else if bar_index - armBullBar >= cisdLookbackInput
        armBull := false

if armBear and barstate.isconfirmed
    if not na(trkHighLvl) and close < trkHighLvl
        cisdSellRaw := true
        armBear     := false
        sellCount   += 1
    else if bar_index - armBearBar >= cisdLookbackInput
        armBear := false

bool buySignal  = cisdBuyRaw  and showCisdInput
bool sellSignal = cisdSellRaw and showCisdInput

if barstate.isconfirmed and fvgPool.size() > 0
    for i = fvgPool.size() - 1 to 0
        FvgZone zone = fvgPool.get(i)
        bool invalid = (zone.isBull and close < zone.bottom) or (not zone.isBull and close > zone.top) or ((time - zone.leftTime) / (chartSec * 1000) > FVG_MAX_AGE)
        if invalid
            fvgPool.remove(i)

if barstate.isconfirmed and newFvgCandle and not na(fvgLeftT)
    if fvgBullGap
        fvgPool.push(FvgZone.new(fvgBullTop, fvgBullBot, fvgLeftT, true))
    if fvgBearGap
        fvgPool.push(FvgZone.new(fvgBearTop, fvgBearBot, fvgLeftT, false))
    while fvgPool.size() > FVG_POOL_MAX
        fvgPool.shift()

var array<line>  signalLines  = array.new<line>()
var array<label> signalLabels = array.new<label>()

if buySignal
    int buyX1 = na(trkLowLvlBar) ? bar_index : math.min(trkLowLvlBar, bar_index)
    signalLines.push(line.new(buyX1, trkLowLvl, bar_index + 2, trkLowLvl, xloc = xloc.bar_index, color = buyColorInput, width = 2, style = line.style_solid))
    signalLabels.push(label.new(bar_index + 2, trkLowLvl, "BUY", xloc = xloc.bar_index, style = label.style_label_left, color = CLR_NONE, textcolor = buyColorInput, size = lblSize, tooltip = "CISD BUY | Level: " + str.tostring(trkLowLvl, format.mintick)))
    f_capLines(signalLines, maxSetupsInput)
    f_capLabels(signalLabels, maxSetupsInput)

if sellSignal
    int sellX1 = na(trkHighLvlBar) ? bar_index : math.min(trkHighLvlBar, bar_index)
    signalLines.push(line.new(sellX1, trkHighLvl, bar_index + 2, trkHighLvl, xloc = xloc.bar_index, color = sellColorInput, width = 2, style = line.style_solid))
    signalLabels.push(label.new(bar_index + 2, trkHighLvl, "SELL", xloc = xloc.bar_index, style = label.style_label_left, color = CLR_NONE, textcolor = sellColorInput, size = lblSize, tooltip = "CISD SELL | Level: " + str.tostring(trkHighLvl, format.mintick)))
    f_capLines(signalLines, maxSetupsInput)
    f_capLabels(signalLabels, maxSetupsInput)

var line        crhLine    = na
var line        crlLine    = na
var line        midLine    = na
var label       crhLabel   = na
var label       crlLabel   = na
var label       cdTopLabel = na
var label       cdBotLabel = na
var array<line> projWicks  = array.new<line>()
var array<box>  projBodies = array.new<box>()
var array<line> sepLines   = array.new<line>()

if barstate.islast
    line.delete(crhLine)
    line.delete(crlLine)
    line.delete(midLine)
    label.delete(crhLabel)
    label.delete(crlLabel)
    label.delete(cdTopLabel)
    label.delete(cdBotLabel)
    crhLine    := na
    crlLine    := na
    midLine    := na
    crhLabel   := na
    crlLabel   := na
    cdTopLabel := na
    cdBotLabel := na
    f_clearLines(projWicks)
    f_clearBoxes(projBodies)
    f_clearLines(sepLines)

    if showCrtInput and hasRange and not na(curCandle)
        int nProj    = htfMode ? midCandles.size() + 2 : 0
        int firstOff = math.max(3, extendLowerInput - PROJ_RIGHT_PAD - math.max(0, nProj - 1) * PROJ_SPACING)
        int lastOff  = firstOff + math.max(0, nProj - 1) * PROJ_SPACING
        int endOff   = htfMode ? math.max(extendBars, lastOff + 4) : extendBars
        endOff      := math.min(endOff, MAX_FUTURE_BARS)
        int lineEndX = extendRightInput ? bar_index + endOff : bar_index
        int hiX      = rangeCandle.hBar
        int loX      = rangeCandle.lBar
        int hiEndX   = math.max(lineEndX, hiX + 1)
        int loEndX   = math.max(lineEndX, loX + 1)

        crhLine := line.new(hiX, rH, hiEndX, rH, xloc = xloc.bar_index, color = crtColorInput, width = lineWidthInput, style = line.style_solid)
        crlLine := line.new(loX, rL, loEndX, rL, xloc = xloc.bar_index, color = crtColorInput, width = lineWidthInput, style = line.style_solid)

        if showMidInput
            int midX = math.max(hiX, loX)
            midLine := line.new(midX, rM, math.max(lineEndX, midX + 1), rM, xloc = xloc.bar_index, color = midColorInput, width = 1, style = line.style_dashed)

        if showLabelsInput
            crhLabel := label.new(hiEndX, rH, tfText + " CRH", xloc = xloc.bar_index, style = label.style_label_left, color = CLR_NONE, textcolor = crtColorInput, size = lblSize, tooltip = "Candle Range High (" + tfText + "): " + str.tostring(rH, format.mintick))
            crlLabel := label.new(loEndX, rL, tfText + " CRL", xloc = xloc.bar_index, style = label.style_label_left, color = CLR_NONE, textcolor = crtColorInput, size = lblSize, tooltip = "Candle Range Low (" + tfText + "): " + str.tostring(rL, format.mintick))

        if htfMode
            float sepY1 = rL
            float sepY2 = rH > rL ? rH : rL + syminfo.mintick
            sepLines.push(line.new(rangeCandle.startBar, sepY1, rangeCandle.startBar, sepY2, xloc = xloc.bar_index, extend = extend.both, color = sepColorInput, style = line.style_dotted, width = 1))
            for m in midCandles
                sepLines.push(line.new(m.startBar, sepY1, m.startBar, sepY2, xloc = xloc.bar_index, extend = extend.both, color = sepColorInput, style = line.style_dotted, width = 1))
            sepLines.push(line.new(curCandle.startBar, sepY1, curCandle.startBar, sepY2, xloc = xloc.bar_index, extend = extend.both, color = sepColorInput, style = line.style_dotted, width = 1))

            array<HtfCandle> seq = array.new<HtfCandle>()
            seq.push(rangeCandle)
            for m in midCandles
                seq.push(m)
            seq.push(curCandle)
            float projTop = rH
            float projBot = rL
            for [i, cd] in seq
                int   cx      = bar_index + firstOff + i * PROJ_SPACING
                float bodyTop = math.max(cd.o, cd.c)
                float bodyBot = math.min(cd.o, cd.c)
                color bodyCol = cd.c < cd.o ? crtColorInput : color.new(crtColorInput, 70)
                if cd.h > bodyTop
                    projWicks.push(line.new(cx, cd.h, cx, bodyTop, xloc = xloc.bar_index, color = crtColorInput, width = 1, style = line.style_solid))
                if cd.l < bodyBot
                    projWicks.push(line.new(cx, bodyBot, cx, cd.l, xloc = xloc.bar_index, color = crtColorInput, width = 1, style = line.style_solid))
                projBodies.push(box.new(cx - PROJ_HALF_WIDTH, bodyTop, cx + PROJ_HALF_WIDTH, bodyBot, border_color = crtColorInput, border_width = 1, xloc = xloc.bar_index, bgcolor = bodyCol))
                projTop := math.max(projTop, cd.h)
                projBot := math.min(projBot, cd.l)

            int    midIdx = math.round((nProj - 1) / 2)
            int    cdX    = bar_index + firstOff + midIdx * PROJ_SPACING
            string cdText = f_countdown(htfCloseT - timenow)
            cdTopLabel := label.new(cdX, projTop, cdText, xloc = xloc.bar_index, style = label.style_label_down, color = CLR_NONE, textcolor = crtColorInput, size = lblSize, tooltip = "Time left until the " + tfText + " candle closes")
            cdBotLabel := label.new(cdX, projBot, cdText, xloc = xloc.bar_index, style = label.style_label_up, color = CLR_NONE, textcolor = crtColorInput, size = lblSize, tooltip = "Time left until the " + tfText + " candle closes")

plot(rH, title = "CRH", color = crtColorInput, display = display.data_window)
plot(rL, title = "CRL", color = crtColorInput, display = display.data_window)
plot(rM, title = "CRT 50%", color = midColorInput, display = display.data_window)
plotshape(buySignal, title = "CISD BUY", style = shape.triangleup, location = location.belowbar, color = buyColorInput, size = size.tiny)
plotshape(sellSignal, title = "CISD SELL", style = shape.triangledown, location = location.abovebar, color = sellColorInput, size = size.tiny)
barcolor(showCrtInput and (bullSweep or bearSweep) ? sweepColorInput : na, title = "CRT Sweep Candle")

var table dashTable = showDashInput ? table.new(position.top_right, 2, 7, bgcolor = CLR_NONE, frame_color = DASH_BORDER, frame_width = 1, border_color = DASH_BORDER, border_width = 1) : na

if barstate.isfirst and not na(dashTable)
    table.cell(dashTable, 0, 0, DASH_TITLE, text_color = DASH_TEXT_LIGHT, text_halign = text.align_center, text_size = size.normal, bgcolor = dashHeaderColorInput)
    table.cell(dashTable, 1, 0, "", bgcolor = dashHeaderColorInput)
    table.merge_cells(dashTable, 0, 0, 1, 0)

if barstate.islast and not na(dashTable)
    array<string> tfNames  = array.from("1H", "2H", "3H", "4H", "6H", "12H")
    array<int>    tfStates = array.from(nz(st1h), nz(st2h), nz(st3h), nz(st4h), nz(st6h), nz(st12h))
    for i = 0 to 5
        bool isActive = tfStates.get(i) == 1
        table.cell(dashTable, 0, i + 1, tfNames.get(i), text_color = DASH_TEXT_DARK, text_halign = text.align_left, text_size = size.small, bgcolor = dashTfColorInput)
        table.cell(dashTable, 1, i + 1, isActive ? "ACTIVE" : "-", text_color = isActive ? DASH_TEXT_DARK : DASH_TEXT_LIGHT, text_halign = text.align_center, text_size = size.small, bgcolor = isActive ? dashActiveColorInput : dashInactiveColorInput, tooltip = tfNames.get(i) + (isActive ? " CRT range active" : " no active CRT range"))

float buyConversion  = sweepLowCount  > 0 ? float(buyCount)  / float(sweepLowCount)  * 100.0 : 0.0
float sellConversion = sweepHighCount > 0 ? float(sellCount) / float(sweepHighCount) * 100.0 : 0.0

if barstate.islast and not na(dashTable)
    string rangeInfo = hasRange ? tfText + " CRH: " + str.tostring(rH, format.mintick) + " | CRL: " + str.tostring(rL, format.mintick) + " | Age: " + str.tostring(rangeAge) + "/" + str.tostring(maxResetInput) : "No active range"
    string statsText = "Mode: " + (htfMode ? "HTF projection" : "Chart candles") + "\n" + rangeInfo + "\nRanges formed: " + str.tostring(rangeCount) + "\nCRH sweeps: " + str.tostring(sweepHighCount) + " | CRL sweeps: " + str.tostring(sweepLowCount) + "\nCISD BUY: " + str.tostring(buyCount) + " (" + str.tostring(buyConversion, "#.#") + "% of CRL sweeps)" + "\nCISD SELL: " + str.tostring(sellCount) + " (" + str.tostring(sellConversion, "#.#") + "% of CRH sweeps)"
    table.cell_set_tooltip(dashTable, 0, 0, statsText)

alertcondition(buySignal,  title = "CRT BUY (CISD)",  message = "CRTBYSSB: BUY (CISD) on {{ticker}} ({{interval}}) at {{close}}")
alertcondition(sellSignal, title = "CRT SELL (CISD)", message = "CRTBYSSB: SELL (CISD) on {{ticker}} ({{interval}}) at {{close}}")
alertcondition(bearSweep,  title = "CRT Sweep High",  message = "CRTBYSSB: CRT Sweep High (CRH taken, closed back inside) on {{ticker}} ({{interval}}) at {{close}}")
alertcondition(bullSweep,  title = "CRT Sweep Low",   message = "CRTBYSSB: CRT Sweep Low (CRL taken, closed back inside) on {{ticker}} ({{interval}}) at {{close}}")

if showAlertsInput
    if buySignal
        alert("CRTBYSSB | BUY (CISD) | " + syminfo.ticker + " | " + tfText + " CRT | Level: " + str.tostring(trkLowLvl, format.mintick) + " | Close: " + str.tostring(close, format.mintick), alert.freq_once_per_bar_close)
    if sellSignal
        alert("CRTBYSSB | SELL (CISD) | " + syminfo.ticker + " | " + tfText + " CRT | Level: " + str.tostring(trkHighLvl, format.mintick) + " | Close: " + str.tostring(close, format.mintick), alert.freq_once_per_bar_close)
    if bearSweep
        alert("CRTBYSSB | CRT Sweep High | " + syminfo.ticker + " | " + tfText + " CRH: " + str.tostring(rH, format.mintick) + " | Close: " + str.tostring(close, format.mintick), alert.freq_once_per_bar_close)
    if bullSweep
        alert("CRTBYSSB | CRT Sweep Low | " + syminfo.ticker + " | " + tfText + " CRL: " + str.tostring(rL, format.mintick) + " | Close: " + str.tostring(close, format.mintick), alert.freq_once_per_bar_close)